{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Docs by Amanda Mashburn",
  "colors": {
    "primary": "#333333",
    "light": "#333333",
    "dark": "#CCCCCC"
  },
  "fonts": {
    "heading": {
      "family": "IBM Plex Serif"
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "favicon": "/assets/favicon.svg",
