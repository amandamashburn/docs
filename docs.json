            "group": "Articles",
            "pages": [
              "pages/index-articles",
              "pages/article-infrastructure",
              "pages/article-share-knowledge",
              "pages/article-DE-SC-26-016"
            ]
          }
        ]
      },
      {
        "tab": "Life Management",
        "groups": [
          {
            "group": "Life Management",
            "pages": [
              "pages/index-life-management"
            ]
          }
        ]
      }
