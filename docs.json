  },
  "seo": {
    "metatags": {
      "og:image": "/assets/meta-tag.png",
      "og:site_name": "Docs by Amanda Mashburn",
      "twitter:card": "summary_large_image",
      "twitter:site": "@AmandaMashburn",
      "twitter:image": "/assets/meta-tag.png"
    }
