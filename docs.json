    "global": {
      "anchors": [
        {
          "anchor": "About Amanda",
          "href": "https://www.amandamashburn.com",
          "icon": "page"
        }
      ]
    }
  },
  "logo": {
    "light": "/assets/docs_by_amanda_light.svg",
    "dark": "/assets/docs_by_amanda_light.svg"
  },
  "navbar": {},
